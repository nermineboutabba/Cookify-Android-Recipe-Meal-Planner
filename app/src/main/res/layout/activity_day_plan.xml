<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFF8E1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="80dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- DATE -->
            <TextView
                android:id="@+id/dateTitle"
                android:text="Today"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FF9800"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- BREAKFAST CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/breakfastCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/breakfastImage"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:id="@+id/breakfastName"
                        android:padding="8dp"
                        android:text="Tap to choose breakfast"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- LUNCH CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lunchCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/lunchImage"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:id="@+id/lunchName"
                        android:padding="8dp"
                        android:text="Tap to choose lunch"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- DINNER CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dinnerCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/dinnerImage"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:id="@+id/dinnerName"
                        android:padding="8dp"
                        android:text="Tap to choose dinner"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- NOTES -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/notesInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SAVE BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveBtn"
                android:text="Save Plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FF9800"/>

            <!-- CLEAR BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearBtn"
                android:text="Clear Plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFD54F"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>